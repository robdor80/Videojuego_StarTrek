{
  "schema_version": "0.1.0",
  "fixture_id": "sensor_watchstanding_acceptance_v0.1",
  "status": "ACCEPTANCE",
  "purpose": "Validate autonomous 24/7 passive Sensor watchstanding without manufacturing events.",
  "cases": [
    {
      "id": "SW-001",
      "name": "Quiet watch remains quiet",
      "given": [
        "ship_operational",
        "passive_watch_enabled",
        "no_meaningful_world_state_change"
      ],
      "when": "eight_hours_simulated_watch_elapse",
      "expect": [
        "short_range_watch_continues",
        "long_range_watch_continues",
        "zero_fabricated_contacts",
        "zero_fabricated_anomalies",
        "zero_required_alerts"
      ]
    },
    {
      "id": "SW-002",
      "name": "Recognized transponder acquired automatically",
      "given": [
        "new_contact_becomes_detectable",
        "recognized_transponder=true"
      ],
      "when": "passive_cycle_observes_contact",
      "expect": [
        "contact_added_without_manual_scan",
        "contact_identified",
        "available_distance_vector_velocity_confidence_presented",
        "no_llm_required"
      ]
    },
    {
      "id": "SW-003",
      "name": "Unknown contact highlighted",
      "given": [
        "new_contact_becomes_detectable",
        "no_sufficient_identification"
      ],
      "when": "passive_cycle_observes_contact",
      "expect": [
        "contact_added_as_unknown",
        "officer_attention_highlight=true",
        "identity_not_invented",
        "officer_can_act_on_contact"
      ]
    },
    {
      "id": "SW-004",
      "name": "Sudden unexplained loss raises anomaly",
      "given": [
        "contact_previously_stable",
        "previous_confidence>=60",
        "contact_suddenly_not_detectable",
        "no_known_loss_reason"
      ],
      "when": "next_passive_cycle_runs",
      "expect": [
        "anomalous_contact_loss_alert",
        "last_confidence_reported",
        "last_distance_reported",
        "last_vector_reported",
        "last_velocity_reported",
        "cause_reported_as_unknown",
        "no_explosion_claim",
        "no_cloak_claim",
        "no_warp_departure_claim"
      ]
    },
    {
      "id": "SW-005",
      "name": "Explained loss is not falsely anomalous",
      "given": [
        "contact_leaves_passive_range",
        "loss_reason=out_of_range"
      ],
      "when": "next_passive_cycle_runs",
      "expect": [
        "loss_logged_or_reported_according_to_policy",
        "no_anomalous_loss_claim"
      ]
    },
    {
      "id": "SW-006",
      "name": "Officer work does not disable background watch",
      "given": [
        "officer_is_using_console_for_other_task",
        "passive_watch_enabled"
      ],
      "when": "world_state_changes_during_watch",
      "expect": [
        "passive_watch_still_evaluates_change",
        "meaningful_alert_can_be_raised"
      ]
    },
    {
      "id": "SW-007",
      "name": "Sensor watch belongs to ship runtime",
      "given": [
        "player_not_at_sensor_console",
        "ship_runtime_advances"
      ],
      "when": "contact_becomes_detectable_offscreen",
      "expect": [
        "event_resolved_by_ship_runtime",
        "sensor_picture_reconstructed_on_resume",
        "ui_not_owner_of_surveillance"
      ]
    },
    {
      "id": "SW-008",
      "name": "Report goes to current bridge command",
      "given": [
        "sensor_event_requires_human_report",
        "captain_not_in_command_of_bridge_watch"
      ],
      "when": "sensor_officer_reports_event",
      "expect": [
        "recipient=current_bridge_command_officer",
        "captain_only_if_escalated_or_required"
      ]
    },
    {
      "id": "SW-009",
      "name": "Lost contact rejects live operations",
      "given": [
        "contact_status=lost",
        "contact_not_in_current_sensor_solution"
      ],
      "when": "officer_orders_live_operation_on_lost_contact",
      "expect": [
        "operation_not_executed",
        "tracking_not_created",
        "watch_not_created",
        "focused_live_analysis_not_fabricated",
        "computer_reports_operation_unavailable",
        "historical_last_known_data_remains_queryable",
        "explicit_reacquisition_may_be_attempted_only_when_physically_possible"
      ]
    },
    {
      "id": "SW-010",
      "name": "Meaningful contact behavior change is reported without inventing hostility",
      "given": [
        "identified_non_hostile_contact_visible",
        "contact_changes_course",
        "contact_accelerates",
        "relative_motion_becomes_approaching",
        "closest_approach_becomes_operationally_significant",
        "no_hostile_indicator_confirmed"
      ],
      "when": "next_passive_cycle_runs",
      "expect": [
        "significant_behavior_change_alert",
        "new_course_reported",
        "new_velocity_reported",
        "closest_approach_reported",
        "contact_may_become_high_operational_priority",
        "no_hostile_claim"
      ]
    },
    {
      "id": "SW-011",
      "name": "Romulan warbird acquisition is plotted consistently in zenith and profile views",
      "given": [
        "identified_romulan_warbird_initially_outside_sensor_range",
        "contact_enters_long_range",
        "bearing_is_118_deg",
        "elevation_is_minus_7_deg",
        "course_is_287_deg_with_plus_2_deg_vertical_component",
        "military_contact_without_confirmed_hostility"
      ],
      "when": "next_passive_cycle_and_spatial_display_update_run",
      "expect": [
        "contact_is_acquired_and_selected",
        "zenith_marker_appears_at_118_deg",
        "profile_marker_appears_below_reference_plane_at_minus_7_deg",
        "course_vector_is_visible_in_both_views",
        "operational_priority_is_high",
        "hostility_is_not_invented"
      ]
    },
    {
      "id": "SW-012",
      "name": "Contact action deck changes with selected contact context",
      "given": [
        "sensor_console_v03_active",
        "different_contact_categories_are_selectable"
      ],
      "when": "officer_selects_unknown_civilian_military_natural_or_lost_contact",
      "expect": [
        "maximum_eight_visible_action_slots",
        "actions_are_resolved_deterministically_from_contact_state",
        "irrelevant_actions_are_hidden",
        "military_affiliation_does_not_imply_hostility",
        "gemini_not_required_to_choose_buttons"
      ]
    },
    {
      "id": "SW-013",
      "name": "Tracking control evolves inside one action slot",
      "given": [
        "live_contact_selected",
        "tracking_initially_inactive"
      ],
      "when": "officer_cycles_standard_intensified_and_stopped_tracking",
      "expect": [
        "inactive_state_shows_follow",
        "standard_tracking_shows_diagonal_intensify_and_stop_control",
        "intensified_tracking_shows_diagonal_standard_and_stop_control",
        "intensified_tracking_consumes_more_tracking_capacity",
        "intensified_tracking_improves_tracking_quality",
        "stop_returns_control_to_follow"
      ]
    },
    {
      "id": "SW-014",
      "name": "Lost contact action deck exposes only historical or recovery-safe actions",
      "given": [
        "selected_contact_is_lost"
      ],
      "when": "contact_action_resolver_builds_available_controls",
      "expect": [
        "live_analysis_actions_hidden",
        "live_tracking_start_hidden",
        "last_known_data_available",
        "existing_tracking_may_be_stopped",
        "reacquisition_disabled_when_no_current_signal_exists",
        "historical_data_can_be_transferred"
      ]
    }
  ]
}
