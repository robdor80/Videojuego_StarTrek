#!/bin/sh
set -eu
cd "$(git rev-parse --show-toplevel)"
if command -v python >/dev/null 2>&1; then
  exec python desarrollo/tools/git_binary_guard.py
elif command -v python3 >/dev/null 2>&1; then
  exec python3 desarrollo/tools/git_binary_guard.py
else
  echo 'Git: Python 3 es necesario para validar el indice.' >&2
  exit 1
fi
