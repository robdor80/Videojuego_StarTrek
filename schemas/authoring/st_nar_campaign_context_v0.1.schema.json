{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://robertodorado.es/schemas/authoring/st-nar-campaign-context-v0.1.schema.json",
  "title": "ST-NAR-00 external authoring context export v0.1 (NOT a save)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "export_mode",
    "knowledge_scope",
    "provenance",
    "campaign",
    "coverage",
    "history",
    "current",
    "installed_seasons",
    "pending_season_plans",
    "capability_ids"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "export_mode": {
      "enum": [
        "full",
        "delta"
      ]
    },
    "knowledge_scope": {
      "enum": [
        "full_authoring",
        "player_visible"
      ]
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_kind",
        "evidence_ref",
        "is_runtime_verified"
      ],
      "properties": {
        "source_kind": {
          "enum": [
            "offline_fixture",
            "runtime_adapter"
          ]
        },
        "evidence_ref": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 500
        },
        "is_runtime_verified": {
          "type": "boolean"
        }
      }
    },
    "campaign": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "campaign_id",
        "snapshot_revision",
        "catalog_revision",
        "world_time",
        "foreground_main_season_id"
      ],
      "properties": {
        "campaign_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]{2,79}$"
        },
        "snapshot_revision": {
          "type": "integer",
          "minimum": 0
        },
        "catalog_revision": {
          "type": "integer",
          "minimum": 0
        },
        "world_time": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}$"
        },
        "foreground_main_season_id": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_.-]{2,79}$"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "complete",
        "from_event_cursor",
        "to_event_cursor",
        "event_total",
        "base_snapshot_revision"
      ],
      "properties": {
        "complete": {
          "type": "boolean"
        },
        "from_event_cursor": {
          "type": "integer",
          "minimum": 0
        },
        "to_event_cursor": {
          "type": "integer",
          "minimum": 0
        },
        "event_total": {
          "type": "integer",
          "minimum": 0
        },
        "base_snapshot_revision": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "history": {
      "type": "array",
      "maxItems": 100000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sequence",
          "event_id",
          "occurred_at",
          "kind",
          "fact_ids",
          "summary_es",
          "visibility"
        ],
        "properties": {
          "sequence": {
            "type": "integer",
            "minimum": 1
          },
          "event_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]{2,79}$"
          },
          "occurred_at": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}$"
          },
          "kind": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]{2,79}$"
          },
          "fact_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_.-]{2,79}$"
            },
            "uniqueItems": true,
            "maxItems": 10000
          },
          "summary_es": {
            "type": "string",
            "minLength": 1,
            "maxLength": 3000
          },
          "visibility": {
            "enum": [
              "authoring_only",
              "player_known"
            ]
          }
        }
      }
    },
    "current": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "historical_fact_ids",
        "current_fact_ids",
        "active_world_event_ids",
        "open_operational_need_ids",
        "entity_state_refs",
        "world_summary_es",
        "relevant_entities"
      ],
      "properties": {
        "historical_fact_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]{2,79}$"
          },
          "uniqueItems": true,
          "maxItems": 10000
        },
        "current_fact_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]{2,79}$"
          },
          "uniqueItems": true,
          "maxItems": 10000
        },
        "active_world_event_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]{2,79}$"
          },
          "uniqueItems": true,
          "maxItems": 10000
        },
        "open_operational_need_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]{2,79}$"
          },
          "uniqueItems": true,
          "maxItems": 10000
        },
        "entity_state_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]{2,79}$"
          },
          "uniqueItems": true,
          "maxItems": 10000
        },
        "world_summary_es": {
          "type": "string",
          "minLength": 1,
          "maxLength": 3000
        },
        "relevant_entities": {
          "type": "array",
          "maxItems": 3000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "entity_id",
              "state_summary_es",
              "known_to_player"
            ],
            "properties": {
              "entity_id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_.-]{2,79}$"
              },
              "state_summary_es": {
                "type": "string",
                "minLength": 1,
                "maxLength": 3000
              },
              "known_to_player": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    "installed_seasons": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "season_id",
          "pack_id",
          "pack_version",
          "state",
          "confirmed_outcome_ids",
          "actual_summary_es"
        ],
        "properties": {
          "season_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]{2,79}$"
          },
          "pack_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]{2,79}$"
          },
          "pack_version": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
          },
          "state": {
            "enum": [
              "installed",
              "in_progress",
              "completed",
              "failed",
              "superseded",
              "unavailable"
            ]
          },
          "confirmed_outcome_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_.-]{2,79}$"
            },
            "uniqueItems": true,
            "maxItems": 10000
          },
          "actual_summary_es": {
            "type": "string",
            "maxLength": 3000
          }
        }
      }
    },
    "pending_season_plans": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "season_id",
          "pack_id",
          "pack_version",
          "planned_chapter_ids",
          "is_future_proposal",
          "premise_es",
          "planned_outline_es",
          "possible_outcomes_es",
          "key_character_refs"
        ],
        "properties": {
          "season_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]{2,79}$"
          },
          "pack_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]{2,79}$"
          },
          "pack_version": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
          },
          "planned_chapter_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_.-]{2,79}$"
            },
            "uniqueItems": true,
            "maxItems": 10000
          },
          "is_future_proposal": {
            "const": true
          },
          "premise_es": {
            "type": "string",
            "minLength": 1,
            "maxLength": 3000
          },
          "planned_outline_es": {
            "type": "string",
            "minLength": 1,
            "maxLength": 3000
          },
          "possible_outcomes_es": {
            "type": "array",
            "maxItems": 50,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 3000
            }
          },
          "key_character_refs": {
            "type": "array",
            "uniqueItems": true,
            "maxItems": 100,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_.-]{2,79}$"
            }
          }
        }
      }
    },
    "capability_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_.-]{2,79}$"
      },
      "uniqueItems": true,
      "maxItems": 10000
    }
  }
}
