  "narrative_rules": [
    {
      "id": "E-R01",
      "area": "language",
      "rule_es": "Lengua, especie, ciudadanía, identidad cultural y competencia individual no son equivalentes."
    },
    {
      "id": "E-R02",
      "area": "language",
      "rule_es": "El catálogo existente de ocho lenguas es una muestra, no un censo completo; los registros Delta no desbloquean el DLC."
    },
    {
      "id": "E-R03",
      "area": "language",
      "rule_es": "Nombres propios, exónimos, endónimos y transliteraciones exigen evidencia; la IA no revela autodenominaciones antes de conocerlas."
    },
    {
      "id": "E-R04",
      "area": "translation",
      "rule_es": "Una traducción literal correcta puede expresar una intención cultural incorrecta; usar incertidumbre explícita."
    },
    {
      "id": "E-R05",
      "area": "translation",
      "rule_es": "La mejora de una matriz requiere observaciones/intercambios causales aceptados y persiste; no se recalcula por escena."
    },
    {
      "id": "E-R06",
      "area": "communication",
      "rule_es": "La calidad del enlace, el cifrado, la autenticación, la demora y la traducción son capas independientes."
    },
    {
      "id": "E-R07",
      "area": "communication",
      "rule_es": "Una señal emitida no concede recepción ni conocimiento; transmisor y destinatario conservan vistas diferentes."
    },
    {
      "id": "E-R08",
      "area": "communication",
      "rule_es": "Mensajes y órdenes requieren emisor/autoridad comprobables; F11 decide validez, HOST no reimplementa F11."
    },
    {
      "id": "E-R09",
      "area": "exploration",
      "rule_es": "Objeto real, detección, identificación, cartografía, visita y publicación son eventos/estados distintos."
    },
    {
      "id": "E-R10",
      "area": "exploration",
      "rule_es": "No revelar ruinas, formas de vida, recursos, rutas ni propiedades por un escaneo genérico si sensores y CoreRPG no lo exponen."
    },
    {
      "id": "E-R11",
      "area": "exploration",
      "rule_es": "La ficha de carta puede caducar; una base de datos no conoce el mundo automáticamente."
    },
    {
      "id": "E-R12",
      "area": "first_contact",
      "rule_es": "Descubrir vida inteligente no equivale a permiso de contacto, tratado, membresía ni soberanía."
    },
    {
      "id": "E-R13",
      "area": "first_contact",
      "rule_es": "Primera Directriz obliga a revisar desarrollo, contaminación, consentimiento, jurisdicción y cadena de mando; no hay excepción automática."
    },
    {
      "id": "E-R14",
      "area": "first_contact",
      "rule_es": "Una facción, capitán local o científico no representa necesariamente a toda su civilización."
    },
    {
      "id": "E-R15",
      "area": "knowledge",
      "rule_es": "El PADD exterior combina conocimiento adquirido y permisos; secretos no se exportan por precaución."
    },
    {
      "id": "E-R16",
      "area": "presentation",
      "rule_es": "El idioma del jugador es español de España; el doblaje/voz no garantiza idioma diegético conocido."
    },
    {
      "id": "E-R17",
      "area": "world",
      "rule_es": "El universo causal persiste sin presencia del jugador, no se generan civilizaciones o eventos para satisfacerle."
    },
    {
      "id": "E-R18",
      "area": "world",
      "rule_es": "Enterprise-D (NCC-1701-D) clase Galaxy sigue en reconstrucción 2383; no suponer disponible en 2387."
    }
  ]
