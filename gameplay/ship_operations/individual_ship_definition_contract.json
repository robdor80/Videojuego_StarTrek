{
  "schema_version": "0.2.0",
  "required_fields": [
    "ship_id",
    "display_name",
    "class_id",
    "operator"
  ],
  "identity_fields": [
    "ship_id",
    "registry",
    "registry_history"
  ],
  "history_fields": [
    "historical_events",
    "retained_era_ids",
    "post_boundary_policy"
  ],
  "optional_fields": [
    "individual_special_configuration",
    "known_command_history",
    "known_assignment_history",
    "refit_history",
    "notes"
  ],
  "bootstrap_rule": "historical_events_are_input_only_before_campaign_start",
  "runtime_rule": "individual_ship_definition_bootstraps_entity_but_is_not_live_state",
  "entity_identity_contract_ref": "universe/generation/persistent_entity_identity_contract.json",
  "persistence_contract_ref": "gameplay/persistence/persistent_state_roundtrip_contract.json",
  "identity_rules": [
    "Ship identity persists through repair, refit, change of crew, command, assignment, operator state and location.",
    "Class/configuration changes caused by explicit refit do not silently create a new ship entity.",
    "Registry history may change while ship_id remains authoritative technical identity."
  ]
}
