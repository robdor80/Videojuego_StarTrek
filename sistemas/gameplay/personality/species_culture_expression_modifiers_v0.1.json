{
  "schema_version": "0.1.0",
  "modifier_set_id": "species_culture_personality_expression_modifiers",
  "status": "FOUNDATION",
  "principle": "Species does not choose personality. Attached culture/upbringing can modify learned expression, register and interpretation while preserving the same core personality.",
  "application_order": [
    "persistent personality core",
    "attached culture/upbringing expression modifiers",
    "institution/profession register",
    "relationship-specific behavior",
    "current state"
  ],
  "socialization_prior_limit": 0.1,
  "expression_modifier_limit": 0.3,
  "hybrid_rule": "Never average species numerically. Resolve actual upbringing/culture_refs and individual history.",
  "modifiers": {
    "human_federation": {
      "trigger": "relevant human/Earth/Federation culture_refs only; Human species alone is insufficient",
      "socialization_priors": {},
      "expression_effects": {},
      "note": "No single Human expression default. Regional/colony/institutional culture decides."
    },
    "vulcan_mainstream": {
      "trigger": "vulcan cultural socialization ref",
      "socialization_priors": {
        "formality": 0.08,
        "conscientiousness": 0.06
