        "formal_register": 0.2,
        "evidence_first_disagreement": 0.25,
        "small_talk_frequency": -0.1
      },
      "humor_style_bias": [
        "dry",
        "deadpan"
      ],
      "guardrails": [
        "Do not suppress core empathy.",
        "Do not make every Vulcan emotionless or humorless.",
        "Individual personality can be warm, ambitious, curious, shy, bold, etc."
      ]
    },
