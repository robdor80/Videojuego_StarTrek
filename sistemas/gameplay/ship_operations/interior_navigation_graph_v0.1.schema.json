{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Interior navigation graph v0.1",
  "type": "object",
  "required": ["schema_version", "ship_id", "map_revision", "locations", "links"],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "ship_id": {"type": "string", "minLength": 1},
    "map_revision": {"type": "string", "minLength": 1},
    "source": {"type": "string"},
    "locations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["location_id", "display_es", "deck_or_section", "location_type"],
        "properties": {
          "location_id": {"type": "string"},
          "display_es": {"type": "string"},
          "deck_or_section": {"type": "string"},
          "location_type": {"type": "string"},
          "scene_id": {"type": "string"},
          "access_level": {"type": "string"},
          "plan_xy": {"type": "array", "items": {"type": "number"}, "minItems": 2, "maxItems": 2}
        }
      }
    },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["link_id", "from", "to", "mode", "verified"],
        "properties": {
          "link_id": {"type": "string"},
          "from": {"type": "string"},
          "to": {"type": "string"},
          "mode": {"enum": ["walk", "door", "stairs", "turbolift", "virtual_transition"]},
          "bidirectional": {"type": "boolean"},
          "verified": {"const": true},
          "cost": {"type": "number", "exclusiveMinimum": 0}
        }
      }
    }
  }
}
