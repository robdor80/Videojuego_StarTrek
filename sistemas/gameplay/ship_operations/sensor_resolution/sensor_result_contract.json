{
  "schema_version": "0.1.0",
  "contract_id": "sensor_scan_result",
  "required": [
    "schema_version",
    "engine",
    "scan",
    "summary",
    "detections"
  ],
  "detection_fields": {
    "contact_id": "stable observer-relative contact identifier",
    "resolution_state": [
      "trace_detected",
      "detected_unclassified",
      "partially_resolved",
      "resolved"
    ],
    "confidence": "normalized 0..1 confidence derived from detection score",
    "distance_au": "engine-calculated distance from observer origin",
    "observed_signatures": "only signatures actually detected",
    "observed": {
      "estimated_position": "available from detected_unclassified upward",
      "entity_type": "available from partially_resolved upward",
      "properties": "ordinary ground-truth properties available from partially_resolved upward",
      "classification": "available only when resolved",
      "resolved_hidden_properties": "only eligible hidden properties; omitted otherwise"
    }
  },
  "forbidden_player_fields": [
    "authoritative_entity_id",
    "ground_truth",
    "unrevealed_hidden_properties"
  ],
  "rule": "AI/UI may verbalize this structured result but may not add discoveries not present in it.",
  "platform_result_contracts": [
    {
      "ship_id": "uss_enterprise_ncc_1701_d",
      "configuration_id": "galaxy_refit_a2",
      "profile_ref": "sistemas/gameplay/ship_operations/sensor_resolution/enterprise_d_valhalla_sensor_superiority_v0.1.json",
      "expected_ordinary_readout": "complete_correct_immediate",
      "emergency_and_manual_equivalence": true,
      "extended_profile_fields": [
        "weapons_type_location_state",
        "shields",
        "propulsion",
        "trajectory",
        "targetable_subsystems",
        "tactical_assessment"
      ],
      "source": "derived_from_authoritative_world_truth",
      "target_latency_ms": 1000,
      "rule": "No empty tactical report or insufficient armament data for ordinary contact when target profile is active."
    }
  ],
  "runtime_extension_implemented": false
}
