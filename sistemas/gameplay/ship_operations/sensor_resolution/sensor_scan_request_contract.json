{
  "schema_version": "0.1.0",
  "contract_id": "sensor_scan_request",
  "required": [
    "scan_id",
    "observer_id",
    "origin_position_au",
    "range_mode",
    "scan_mode",
    "resolution",
    "filters",
    "scan_duration_s",
    "sensor_profile"
  ],
  "fields": {
    "scan_id": "unique operation id",
    "observer_id": "ship/station/device whose sensor knowledge is being updated",
    "operator_id": "optional character id for logging/evaluation",
    "origin_position_au": "3-element XYZ vector in the materialized system reference frame",
    "sector_id": "optional scope limiter",
    "system_id": "optional scope limiter",
    "range_mode": [
      "short",
      "long",
      "focused"
    ],
    "scan_mode": [
      "passive",
      "active"
    ],
    "resolution": [
      "general",
      "standard",
      "high"
    ],
    "filters": "non-empty list of signature types or ['all']",
    "priority": "optional preferred signature type; improves its detection without excluding other selected filters",
    "scan_duration_s": "positive duration; longer scans have diminishing returns",
    "sensor_profile": {
      "capability": "normalized 0..1 sensor quality/capability",
      "power": "normalized 0..1 power available",
      "integrity": "normalized 0..1 hardware/system integrity"
    }
  },
  "signature_types": [
    "electromagnetic",
    "subspace",
    "gravimetric",
    "thermal",
    "ionizing_radiation",
    "particle",
    "biological",
    "warp",
    "artificial_transponder"
  ],
  "rule": "The console builds this request. The detection engine resolves it against already-materialized world state.",
  "ship_specific_execution_policies": [
    {
      "profile_ref": "sistemas/gameplay/ship_operations/sensor_resolution/enterprise_d_valhalla_sensor_superiority_v0.1.json",
      "ship_id": "uss_enterprise_ncc_1701_d",
      "configuration_id": "galaxy_refit_a2",
      "manual_and_automatic": true,
      "ordinary_report_path": "instant_precomputed_or_deterministic_single_request",
      "scanned_object_not_recreated": true,
      "advanced_scan_duration_is_not_basic_tactical_report_delay": true,
      "background_precomputation": "expected_once_active_contacts_are_acquired",
      "operator_feedback_goal_ms": 1000,
      "backend_implementation_pending": true
    }
  ]
}
