    "authority_distribution",
    "law_institution_refs",
    "security_defense_refs",
    "diplomatic_authority",
    "public_legitimacy_context"
  ],
  "representation_states": [
    "single_planetary_authority",
    "recognized_federal_authority",
    "multiple_sovereign_states",
    "contested_planetary_authority",
