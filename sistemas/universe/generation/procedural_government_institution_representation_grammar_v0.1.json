    "no_single_external_representative",
    "unknown_to_observer"
  ],
  "first_contact_rules": [
    "Do not assume first leader encountered can bind the entire civilization.",
    "Resolve who has lawful/recognized authority for external relations.",
    "For multi-state worlds, contact may initially be limited to one state and may itself alter internal politics.",
    "Starfleet must avoid accidentally recognizing one faction as planetary sovereign without basis.",
    "Government structure may evolve after campaign start without changing civilization_id."
  ],
  "separation_rules": [
    "government != culture",
    "government != species",
    "government != public opinion",
    "government != civilization identity"
  ]
}
