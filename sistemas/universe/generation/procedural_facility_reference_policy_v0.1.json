{
  "schema_version": "0.1.0",
  "policy_id": "procedural_facility_reference_generation_policy",
  "status": "REFERENCE_IMPLEMENTATION_POLICY",
  "score": {
    "formula": "0.25*need_strength + 0.20*service_gap + 0.15*strategic_value + 0.10*site_advantage + 0.10*operator_capacity + 0.10*sustainment + 0.10*duration_score - 0.15*alternative_sufficiency",
    "clamps": [
      0,
      100
    ],
    "duration_score": "min(expected_need_years / 20, 1) * 100"
  },
  "hard_gates": {
    "minimum_need_strength": 30,
    "minimum_expected_need_years": 1,
    "maximum_alternative_sufficiency": 69,
    "minimum_operator_capacity": 50,
    "minimum_site_advantage": 40,
    "minimum_sustainment": 50
  },
  "scale_thresholds": [
