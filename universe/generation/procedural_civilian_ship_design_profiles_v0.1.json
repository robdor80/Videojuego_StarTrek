  "capability_rules": [
    "Role defines required capabilities before optional amenities.",
    "Passenger and colony designs require life-support/passenger capacity separate from duty crew.",
    "Industrial designs require work areas, maintenance and cargo/extraction capacity before recreation.",
    "Medical/rescue designs prioritize medical spaces and response systems.",
    "Weapons are absent by default unless operator/legal/security context authorizes defensive armament.",
    "Smuggling role cannot be generated unless legal/economic world state supplies an illegal-market cause."
  ],
  "reuse_rules": [
    "procedural design_id persists and can be selected for later ships",
    "design production availability can spread across regions/operators only when industrial context permits",
    "individual wear, ownership, cargo and crew never belong to the design definition"
  ]
